{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "types": [
      "vitest/importMeta",
      "vite-plugin-svgr/client",
      "@types/node"
    ],
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "src",
    "../ui-kit/src/components/CurrentPrice.tsx",
    "../hooks/src/config/chain.ts",
    "../ui-kit/src/components/DataLabel.tsx",
    "../pump/src/pages/WsTest.tsx",
    "../cetus-design/src/components/common/SortDropBlock.tsx",
    "../cetus-design/src/components/common/tokenSelectModal",
    "../cetus-design/src/hook/useNotifi",
    "src/components/common/BackToV1.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}